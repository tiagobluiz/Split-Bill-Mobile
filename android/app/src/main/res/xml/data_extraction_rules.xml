<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
  <cloud-backup>
    <include domain="database" path="split-bill-mobile.db" />
    <include domain="database" path="split-bill-mobile.db-shm" />
    <include domain="database" path="split-bill-mobile.db-wal" />
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="SecureStore" />
    <exclude domain="sharedpref" path="SecureStore.xml" />
  </cloud-backup>
  <device-transfer>
    <include domain="database" path="split-bill-mobile.db" />
    <include domain="database" path="split-bill-mobile.db-shm" />
    <include domain="database" path="split-bill-mobile.db-wal" />
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="SecureStore" />
    <exclude domain="sharedpref" path="SecureStore.xml" />
  </device-transfer>
</data-extraction-rules>
