{
  "expo": {
    "name": "Split Bill",
    "slug": "split-bill-mobile",
    "scheme": "split-bill-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.miagology.splitbill",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#A54206"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.miagology.splitbill"
    },
    "androidStatusBar": {
      "backgroundColor": "#f9f9f9",
      "barStyle": "dark-content"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#A54206",
          "image": "./assets/splash-inner-logo.png",
          "resizeMode": "contain",
          "imageWidth": 205
        }
      ],
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#A54206"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8bd5f859-4685-42f0-abdd-2e5d60cbe7ec"
      }
    }
  }
}
